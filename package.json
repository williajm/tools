    "jose": "^5.10.0",
    "js-md5": "^0.8.3",
    "jsondiffpatch": "^0.7.6",
    "jsqr": "^1.4.0",
    "lorem-ipsum": "^2.0.8",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6",
    "preact": "^10.27.2",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
