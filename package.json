{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Developer and test utilities that run entirely in your browser",
  "scripts": {
    "dev": "vite",
    "gen:pages": "node scripts/gen-pages.mjs",
